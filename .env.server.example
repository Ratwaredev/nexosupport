# Solo en el servidor. Nunca uses el prefijo VITE_ para estas claves.
OPENROUTER_API_KEY=sk-or-v1-...
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXO_APP_URL=https://YOUR_NEXO_SITE

# Modelo por defecto o por plan. También puede sobrescribirse por dispositivo en Supabase.
NEXO_DEFAULT_MODEL=openrouter/auto
NEXO_MODEL_BASIC=openrouter/auto
NEXO_MODEL_PRO=openrouter/auto
NEXO_MODEL_MAX=openrouter/auto

# GitHub Actions usa además SUPABASE_ACCESS_TOKEN y SUPABASE_PROJECT_REF
# para desplegar la función y aplicar la migración. Nunca se incluyen en el EXE.
