{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXO Support",
  "version": "0.2.2",
  "identifier": "dev.ratware.underdock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run prepare:icon && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEXO Support",
        "width": 460,
        "height": 680,
        "minWidth": 400,
        "minHeight": 560,
        "maxWidth": 620,
        "maxHeight": 900,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "skipTaskbar": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "resources": ["resources/sensor-helper/", "resources/rustdesk/"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "perMachine"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Ratwaredev/underdocksoporteapp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNDMzOTk0RkFBQjc0QkEKUldTNmRLdjZsRGxEam5BUmZtSTdMZ3RyeXFPRmcvSHUrWWpTZVNQY0c4NVBCK3o3eCt4MlBPVWEK",
      "windows": { "installMode": "silent" }
    }
  }
}
