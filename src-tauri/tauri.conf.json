{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXO Support",
  "version": "0.2.2",
  "identifier": "dev.ratware.underdock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NEXO Support",
        "width": 500,
        "height": 620,
        "minWidth": 460,
        "minHeight": 560,
        "maxWidth": 720,
        "maxHeight": 860,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "skipTaskbar": false,
        "shadow": true,
        "center": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "resources": ["resources/sensor-helper/"],
    "targets": ["nsis"]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Ratwaredev/underdocksoporteapp/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNDMzOTk0RkFBQjc0QkEKUldTNmRLdjZsRGxEam5BUmZtSTdMZ3RyeXFPRmcvSHUrWWpTZVNQY0c4NVBCK3o3eCt4MlBPVWEK",
      "windows": { "installMode": "passive" }
    }
  }
}
